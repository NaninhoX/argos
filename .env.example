# Copie para .env (fora do Git) e preencha. Nunca cole chave em código, issue ou chat.

# Banco. Produção: URL do Neon. Desenvolvimento local, sem conta: pglite://memory (some ao reiniciar)
# ou pglite://.data/dev (fica em disco).
DATABASE_URL=pglite://memory

# Protege /api/cron/* (a Vercel envia "Authorization: Bearer <CRON_SECRET>"). Local: qualquer valor serve.
CRON_SECRET=

# Argos AI: chave do provedor de LLM (só no servidor) e código de acesso exigido em produção.
DEEPSEEK_API_KEY=
ARGOS_ACCESS_CODE=
# ARGOS_LLM_MODEL=deepseek-chat
# ARGOS_LLM_BASE_URL=https://api.deepseek.com

# Servidor local (npm run dev)
# PORT=3000
